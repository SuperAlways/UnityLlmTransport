<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChannelBridge\ChannelBridge.csproj" />
    <!-- Extern alias: the .NET 10 shared framework also ships System.Net.ServerSentEvents, which makes the
         vendored types ambiguous (CS0433). Aliasing the vendored project disambiguates them; the test file
         resolves types via `using VendoredSse::System.Net.ServerSentEvents;`. -->
    <ProjectReference Include="..\SseCompile\SseCompile.csproj" Aliases="VendoredSse" />
  </ItemGroup>

</Project>
